# Optional. Without this key, ClearSkies uses its deterministic local assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server settings
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Rate-limit tuning (per process)
AI_RATE_LIMIT=8
AI_RATE_WINDOW_MS=600000
AIR_RATE_LIMIT=30
AIR_RATE_WINDOW_MS=60000
